# AI Research Assistant environment template
# Copy to .env and fill values. Never commit a real .env file.

# Process
# AI_RA_ENV=development
# AI_RA_DEVELOPER_MODE=false
# AI_RA_DEBUG=false

# Logging
# AI_RA_LOG_LEVEL=INFO
# AI_RA_LOG_FILE=

# LLM: choose "gemini" (fast cloud) or "ollama" (private local)
# AI_RA_API_PROVIDER=ollama
# AI_RA_MODEL=qwen3:4b
# AI_RA_OLLAMA_BASE_URL=http://localhost:11434
# AI_RA_API_KEY=
# AI_RA_TEMPERATURE=0.2
# AI_RA_TOP_P=0.95
# AI_RA_MAX_TOKENS=
# AI_RA_TIMEOUT=120
# AI_RA_CONNECT_TIMEOUT=30
# AI_RA_MAX_RETRIES=3
# AI_RA_MAX_INPUT_CHARACTERS=10000

# Gemini cloud example (free-tier content may be used by Google to improve products)
# AI_RA_API_PROVIDER=gemini
# AI_RA_MODEL=gemini-3.8-flash
# AI_RA_OLLAMA_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# AI_RA_API_KEY=your_private_gemini_api_key
# AI_RA_TIMEOUT=300
# AI_RA_CONNECT_TIMEOUT=30
# AI_RA_MAX_RETRIES=1

# Paths (relative paths resolve against the repository root)
# AI_RA_DATA_DIR=data
# AI_RA_UPLOADS_DIR=data/uploads
# AI_RA_TEMP_DIR=data/tmp
# AI_RA_REPORTS_DIR=data/reports
# AI_RA_LOGS_DIR=data/logs
# AI_RA_CONFIG_DIR=config
# AI_RA_DATABASE_PATH=data/history.db

# Export (markdown and html only)
# AI_RA_EXPORT_DEFAULT_FORMAT=markdown
